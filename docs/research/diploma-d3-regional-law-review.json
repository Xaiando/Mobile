  "caseArithmetic": {
    "jura": "Harvest 2026: cellar through 15 December 2032 and at least 60 veil months; earliest consumer date 1 January 2033. 100 * 0.62 = 62 litres; 100 * EUR 40 = EUR 4,000; EUR 4,000 / 62 = EUR 64.516129 per litre. Add fixed EUR 240 holding cost: EUR 4,240 / 62 = EUR 68.387097 per litre.",
    "tokaj": "135 g/L meets 120 but misses 150; harvest 2025 gives earliest consumer date 1 January 2028. 100 * EUR 25 = EUR 2,500; six months * EUR 60 = EUR 360; plus EUR 180 reprint gives EUR 3,040 listed costs.",
    "china": "200 * CNY 50 = CNY 10,000; A adds CNY 600 + CNY 200 = CNY 800, giving CNY 10,800. B adds CNY 500, giving CNY 10,500. CNY 300 difference concerns only listed costs."
  },
